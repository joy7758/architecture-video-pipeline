  "discovery_transitions": [
    {
      "from": "UNSEEN",
      "to": "DISCOVERED",
      "required": ["discovery_hint", "provisional_source_identity"],
      "actor": "AGENT",
      "failure": "SOURCE_IDENTITY_AMBIGUOUS"
    },
    {
      "from": "DISCOVERED",
      "to": "SOURCE_VERIFIED",
      "required": ["primary_or_official_source", "exact_version", "source_policy_match", "freshness"],
      "actor": "AGENT_AND_SOURCE_VALIDATOR",
      "failure": "SOURCE_NOT_VERIFIED"
    },
    {
      "from": "SOURCE_VERIFIED",
      "to": "FINGERPRINTED",
      "required": ["complete_fingerprint", "fingerprint_digest"],
      "actor": "AGENT",
      "failure": "FINGERPRINT_INCOMPLETE"
    },
    {
      "from": "FINGERPRINTED",
      "to": "COMPARED",
      "required": ["current_internal_inventory", "no_change_baseline", "overlap_assessment"],
      "actor": "AGENT",
      "failure": "COMPARISON_INCOMPLETE"
    },
    {
      "from": "COMPARED",
      "to": "CANDIDATE",
      "required": ["candidate_key", "owner_route", "risk_class", "no_hard_gate_failure"],
      "actor": "AGENT_AND_INDEPENDENT_VERIFIER",
      "failure": "CANDIDATE_INELIGIBLE"
    }
  ],
  "absorption_transitions": [
    {
      "from": "CANDIDATE",
      "to": "ASSESSED",
      "required": ["deep_reasoning_record", "source_checks", "duplication_assessment", "risk_classification"],
      "authority_basis": "CONSTITUTION",
      "failure": "ASSESSMENT_INCOMPLETE"
    },
    {
      "from": "ASSESSED",
      "to": "SANDBOX_VERIFIED",
      "required": ["reproducible_sandbox", "retained_failures", "license_status", "security_status", "rollback_evidence"],
      "authority_basis": "VALID_AC2_STANDING_AUTHORIZATION",
      "failure": "SANDBOX_NOT_VERIFIED"
    },
    {
      "from": "SANDBOX_VERIFIED",
      "to": "AGENT_DECISION_READY",
      "required": ["independent_verifier_pass", "all_bindings_fresh"],
      "authority_basis": "CONSTITUTION",
      "failure": "DECISION_NOT_READY"
    },
    {
      "from": "AGENT_DECISION_READY",
      "to": "REFERENCE_ABSORBED",
      "required": ["ac1_scope_valid"],
      "authority_basis": "VALID_STANDING_AUTHORIZATION",
      "postcondition": "VERIFY_AND_REPORT"
    },
    {
      "from": "AGENT_DECISION_READY",
      "to": "REVERSIBLE_ADOPTION_EXECUTED",
      "required": ["ac3_scope_valid", "exact_owner_path", "tested_rollback", "resource_budget", "all_bindings_valid"],
      "authority_basis": "VALID_STANDING_AUTHORIZATION",
      "postcondition": "VERIFY_RETAIN_OR_ROLLBACK_AND_REPORT"
    },
    {
      "from": "AGENT_DECISION_READY",
      "to": "BOUNDED_CANARY_RUNNING",
      "required": ["ac4_policy", "kill_switch", "limits", "monitoring", "rollback"],
      "authority_basis": "VALID_STANDING_CANARY_AUTHORIZATION",
      "postcondition": "VERIFY_RETAIN_OR_ROLLBACK_AND_REPORT"
    },
    {
      "from": "AGENT_DECISION_READY",
      "to": "DEFERRED_OR_REJECTED",
      "required": ["reason_codes", "retained_evidence"],
      "authority_basis": "CONSTITUTION",
      "postcondition": "REPORT"
    },
    {
      "from": "ANY",
      "to": "HUMAN_EXCEPTION_REQUIRED",
      "required": ["ac5_condition_or_unknown_scope_or_binding_conflict_or_irreversible_effect"],
      "authority_basis": "NO_APPLICABLE_STANDING_AUTHORIZATION",
      "postcondition": "STOP_AND_REQUEST_EXCEPTION_DECISION"
    }
  ],
